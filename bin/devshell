#!/usr/bin/env bash
set -euo pipefail
umask 077
((BASH_VERSINFO[0] > 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] >= 4))) || {
    echo "Requer Bash >=4.4." >&2
    exit 3
}
export PYTHONDONTWRITEBYTECODE=1
source_dir=${BASH_SOURCE[0]%/*}
[[ "$source_dir" != "${BASH_SOURCE[0]}" ]] || source_dir=.
ROOT=$(builtin cd -- "$source_dir/.." && builtin pwd -P)
export DEVSHELL_ROOT="$ROOT"
fail() {
    printf 'devshell: %s\n' "$1" >&2
    exit "${2:-2}"
}
usage() {
    cat <<'HELP'
Uso: devshell COMANDO [opções]
Comandos: setup plan apply status diff doctor update rollback install uninstall project
  project doctor|fix-permissions  Diagnosticar .venv ou revisar seu reparo
  --path CAMINHO  Diretório do projeto (project; default: diretório atual)
  --profile minimal,personal,work,science,extras   Perfis combináveis (default: os do último apply;
                  sem registro, minimal; HOME já aplicada sem registro sai com 2;
                  project, rollback e install --component devshell não usam o registro)
  --dry-run       Planejar sem escrita persistente ou downloads
  --offline       Proibir downloads (análise/configuração já são offline)
  --json          Relatório JSON
  --approve HASH  Aprovar exatamente o plano exibido
  --replace-existing  Aprovar também conflitos de dotfiles preexistentes
  --list          rollback: listar transações, sem alterar estado
  --prune --keep N  rollback: planejar a remoção irreversível dos backups,
                  mantendo a transação atual e N-1 anteriores (com --approve)
  --component devshell|uv|chezmoi|nu|plugins|python|firacode|pyinit  Alvo de install (default: uv)
                  uninstall exige --component python|devshell|pyinit|plugins|firacode
  --help          Mostrar esta ajuda
apply/update alteram só dotfiles. install é separado e exige aprovação.
install --component devshell instala um lançador local para este checkout, sem downloads.
rollback sem --approve exibe o plano; com --approve restaura a última transação.
uninstall sem --approve exibe o que a CLI prova que instalou; com --approve remove só isso.
Desfazer um uninstall é install --component X. Pacotes do sistema e o CPython do uv nunca saem.
setup coordena instalação e aplicação com confirmações; --dry-run apenas inspeciona.
HELP
}
command=${1:-plan}
[[ $# -eq 0 ]] || shift
case "$command" in -h | --help | help)
    usage
    exit 0
    ;;
esac
case "$command" in setup | plan | apply | status | diff | doctor | update | rollback | install | uninstall | project) ;; *) fail "comando desconhecido: $command" ;; esac
project_action=doctor project_path=$PWD project_path_set=0
if [[ "$command" == project && $# -gt 0 && $1 != --* ]]; then
    project_action=$1
    shift
fi
if [[ "$command" == project ]]; then
    case "$project_action" in doctor | fix-permissions) ;; *) fail "ação project desconhecida: $project_action" ;; esac
fi
profile=minimal
json=0 dry_run=0 offline=0 approval='' replace=0 component=uv component_set=0
rollback_list=0 rollback_prune=0 keep='' profile_set=0
while (($#)); do
    case "$1" in
        --profile | --approve | --component | --path | --keep)
            if (($# < 2)) || [[ -z "$2" || "$2" == --* ]]; then
                fail "valor ausente para $1"
            fi
            case "$1" in --profile)
                profile=$2
                profile_set=1
                ;;
            --approve) approval=$2 ;; --component)
                component=$2
                component_set=1
                ;;
            --path)
                project_path=$2
                project_path_set=1
                ;;
            --keep) keep=$2 ;;
            esac
            shift 2
            ;;
        --json)
            json=1
            shift
            ;;
        --dry-run)
            dry_run=1
            shift
            ;;
        --offline)
            offline=1
            shift
            ;;
        --replace-existing)
            replace=1
            shift
            ;;
        --list)
            rollback_list=1
            shift
            ;;
        --prune)
            rollback_prune=1
            shift
            ;;
        --help)
            usage
            exit 0
            ;;
        *) fail "opção desconhecida: $1" ;;
    esac
done
[[ "$command" == project || "$project_path_set" == 0 ]] || fail '--path só é aceito por project'
if [[ "$command" != rollback && ($rollback_list == 1 || $rollback_prune == 1 || -n "$keep") ]]; then
    fail '--list, --prune e --keep só são aceitos por rollback'
fi
if [[ $rollback_list == 1 && ($rollback_prune == 1 || -n "$keep" || -n "$approval") ]]; then
    fail 'rollback --list não aceita --prune, --keep ou --approve'
fi
if ((rollback_prune)) || [[ -n "$keep" ]]; then
    ((rollback_prune)) || fail '--keep requer --prune'
    [[ "$keep" =~ ^[1-9][0-9]*$ ]] || fail 'rollback --prune requer --keep N, com N inteiro >= 1'
fi
# Python da distribuição isolado: .venv ativa, .pth ou PYTHONPATH de projeto não entram na CLI.
python_command=(/usr/bin/python3 -I -B)
devshell_python() { "${python_command[@]}" "$@"; }
command -v "${python_command[0]}" >/dev/null || fail 'Requer Python >=3.11 da distribuição para relatórios/transações.' 3
"${python_command[@]}" -c 'import sys;sys.exit(sys.version_info<(3,11))' || fail 'Requer Python >=3.11.' 3
if [[ "$command" != project ]]; then
    # shellcheck source=lib/platform.sh
    source "$ROOT/lib/platform.sh"
    detect_platform
fi
# R-047: antes de escolher perfis, o estado precisa ser desta HOME e deste XDG_CONFIG_HOME.
# Só project, que não usa o estado, e rollback --list, que só lê, ficam de fora.
if [[ "$command" != project ]] && ! [[ "$command" == rollback && "$rollback_list" == 1 ]]; then
    devshell_python "$ROOT/lib/state.py" state-check
fi
# D-015: informado, lembrado ou minimal; project, rollback e o lançador não dependem do registro.
profile_source=informados
if [[ "$command" == project || "$command" == rollback || "$command" == uninstall || ("$command" == install && "$component" == devshell) ]]; then
    ((profile_set)) || profile_source=padrão
else
    remembered=$(DEVSHELL_PROFILE_INFORMED="$( ((profile_set)) && printf '%s' "$profile")" devshell_python "$ROOT/lib/state.py" profiles-source)
    read -r profile_source profile <<<"$remembered"
fi
# shellcheck source=lib/profiles.sh
source "$ROOT/lib/profiles.sh"
resolve_profiles "$profile"
# R-046: um registro que não corresponde ao aplicado não pode encolher a HOME em silêncio.
[[ "$profile_source" != lembrados ]] || DEVSHELL_PROFILES="$profile" devshell_python "$ROOT/lib/state.py" profiles-check
export DEVSHELL_PROFILE_SOURCE="$profile_source"
export DEVSHELL_PROFILES="$profile" DEVSHELL_JSON="$json" DEVSHELL_OFFLINE="$offline"
export DEVSHELL_APPROVAL="$approval" DEVSHELL_REPLACE="$replace" DEVSHELL_COMPONENT="$component"
if [[ "$command" == project ]]; then
    [[ "$replace" == 0 && "$component_set" == 0 && "$profile_set" == 0 ]] || fail 'project não aceita --replace-existing, --component ou --profile'
    export DEVSHELL_PROJECT_PATH="$project_path" DEVSHELL_DRY_RUN="$dry_run"
    exec "${python_command[@]}" "$ROOT/lib/project.py" "$project_action"
elif [[ "$command" == setup ]]; then
    [[ -z "$approval" && "$replace" == 0 && "$component_set" == 0 ]] || fail 'setup usa confirmações próprias; não aceita --approve, --replace-existing ou --component'
    ((dry_run || json == 0)) || fail 'setup --json requer --dry-run'
    # shellcheck source=lib/setup.sh
    source "$ROOT/lib/setup.sh"
    setup_environment "$dry_run"
elif [[ "$command" == uninstall ]]; then
    ((component_set)) || fail 'uninstall exige --component python|devshell|pyinit|plugins|firacode'
    [[ "$replace" == 0 && "$profile_set" == 0 ]] || fail 'uninstall não aceita --replace-existing nem --profile'
    ((dry_run == 0)) || export DEVSHELL_APPROVAL=''
    exec "${python_command[@]}" "$ROOT/lib/uninstall.py"
elif [[ "$command" == install ]]; then
    # shellcheck source=lib/install.sh
    source "$ROOT/lib/install.sh"
    install_component "$dry_run"
else
    if ((dry_run)) && [[ "$command" == apply || "$command" == update ]]; then command=plan; fi
    if ((dry_run)) && [[ "$command" == rollback ]]; then export DEVSHELL_APPROVAL=''; fi
    rollback_mode=''
    ((rollback_list == 0)) || rollback_mode=list
    ((rollback_prune == 0)) || rollback_mode=prune
    export DEVSHELL_ROLLBACK_MODE="$rollback_mode" DEVSHELL_KEEP="$keep"
    exec "${python_command[@]}" "$ROOT/lib/state.py" "$command"
fi
