# shellcheck shell=bash
case "${XDG_CONFIG_HOME-}" in
    /*) _foundry_env="$XDG_CONFIG_HOME/devshell/env.sh" ;;
    *) _foundry_env="$HOME/.config/devshell/env.sh" ;;
esac
if [[ -r "$_foundry_env" ]]; then
    # shellcheck source=dotfiles/dot_config/devshell/env.sh
    source "$_foundry_env"
fi
unset _foundry_env
