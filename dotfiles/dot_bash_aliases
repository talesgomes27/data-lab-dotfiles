# shellcheck shell=bash
case "${XDG_CONFIG_HOME-}" in
    /*) _foundry_env="$XDG_CONFIG_HOME/devshell/env.sh" ;;
    *) _foundry_env="$HOME/.config/devshell/env.sh" ;;
esac
if [[ -r "$_foundry_env" ]]; then
    # shellcheck source=dotfiles/dot_config/devshell/env.sh
    source "$_foundry_env"
fi
unset _foundry_env
# O -C do alias padrão do Ubuntu pertence ao GNU ls, não ao eza.
if [[ ${BASH_ALIASES[ls]-} == eza\ * && "$(alias l 2>/dev/null)" == "alias l='ls -CF'" ]]; then
    alias l='command ls -CF'
fi
